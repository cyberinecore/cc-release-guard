{
  "name": "@cyberinecore/shipsafe",
  "version": "0.1.0",
  "description": "Zero-dependency release gate: fails an npm tarball, wheel, crate, .vsix, Helm chart or image archive that ships source maps, embedded sources, source or test paths, credential files or secret tokens.",
  "type": "module",
  "bin": {
    "shipsafe": "shipsafe.mjs"
  },
  "files": [
    "shipsafe.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "npm",
    "publish",
    "release",
    "tarball",
    "sourcemap",
    "secrets",
    "supply-chain",
    "pypi",
    "crates",
    "helm",
    "ci"
  ],
  "author": "Nia D Pham <xinchao@nghia-pham.com>",
  "license": "MIT",
  "homepage": "https://github.com/cyberinecore/cc-release-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberinecore/cc-release-guard.git"
  },
  "bugs": {
    "url": "https://github.com/cyberinecore/cc-release-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
