{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*publish*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*semantic-release*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*release-it*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(np)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(np *)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(* np)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(* np *)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
