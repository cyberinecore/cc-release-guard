{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*publish*)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs", "hook"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
