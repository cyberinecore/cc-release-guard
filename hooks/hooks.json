{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*publish*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*semantic-release*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*release-it*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(np)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(np *)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(* np)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(* np *)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*wrangler*pages*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*vercel*--prebuilt*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*netlify*deploy*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*ntl*deploy*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*firebase*deploy*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*gh*release*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*eas*update*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*nuget*push*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*gem*push*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(*mvn*deploy-file*)",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cli/shipsafe.mjs",
              "hook"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
